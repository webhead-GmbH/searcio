<?xml version="1.0"?>
<!-- Webhead scaffold managed file. scaffold:update may refresh this file. -->
<ruleset name="webhead Search Cloud">
    <description>PHPCS rules for webhead Search Cloud</description>

    <!-- The PHP this plugin ships and owns. -->
    <file>searcio.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>blocks</file>

    <!-- The bundled runtime is Mozart's output, not this plugin's code. -->
    <exclude-pattern>includes/Dependencies/*</exclude-pattern>
    <exclude-pattern>includes/classes/dependencies/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!--
        WordPress-Extra is the WordPress standard without WordPress-Docs, which
        asks for a doc comment on every file, class and method. The three
        exclusions are the framework's own style: PSR-4 file names, the
        camel-cased variables of the libraries it calls, and short arrays.
    -->
    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    </rule>

    <!-- Hook names carry the plugin's prefix before a slash. -->
    <rule ref="WordPress.NamingConventions.ValidHookName">
        <properties>
            <property name="additionalWordDelimiters" value="/"/>
        </properties>
    </rule>
</ruleset>
