<?xml version="1.0"?>
<ruleset name="webhead Search Cloud">
    <description>PHPCS rules for webhead Search Cloud</description>

    <file>includes</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
    </rule>
</ruleset>
