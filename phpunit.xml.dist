<?xml version="1.0"?>
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        bootstrap="tests/bootstrap.php"
        backupGlobals="false"
        colors="true"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd">
    <php>
        <env name="WORDPRESS_TABLE_PREFIX" value="wp_"/>
    </php>
    <testsuites>
        <!--
            Pure-PHP unit tests only (no WordPress, no database). The full
            WordPress + database integration suite lives in tests/Integration
            and runs through phpunit-integration.xml.dist under wp-env.
        -->
        <testsuite name="unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
