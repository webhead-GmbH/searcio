<?xml version="1.0" encoding="UTF-8"?>
<!-- Webhead scaffold managed file. scaffold:update may refresh this file. -->
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
        bootstrap="tests/bootstrap.php"
        backupGlobals="false"
        colors="true">
    <!--
        Fast unit suite: no WordPress, no database, no Docker.

            composer test:unit

        Only put tests here that can be proven without WordPress. Anything that
        needs activation, options, capabilities, REST routing, cron, custom
        tables, or hook timing belongs in tests/Integration and runs through
        phpunit-integration.xml.dist under wp-env.
    -->
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
