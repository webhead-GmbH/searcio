{
    "name": "webhead-search-cloud",
    "version": "1.3.1",
    "description": "Connect WordPress and WooCommerce to Searcio.",
    "main": "src/admin/settings/index.js",
    "scripts": {
        "start": "wp-scripts start",
        "build": "wp-scripts build",
        "test:js": "wp-scripts test-unit-jest",
        "test:e2e": "wp-scripts test-playwright --config playwright.config.js",
        "test:e2e:headed": "wp-scripts test-playwright --config playwright.config.js --headed",
        "test:e2e:desktop": "wp-scripts test-playwright --config playwright.config.js --project=desktop-chrome",
        "wp-env": "wp-env",
        "composer": "wp-env run cli --env-cwd=wp-content/plugins/webhead-search-cloud composer",
        "composer:tests-cli": "wp-env run tests-cli --env-cwd=wp-content/plugins/webhead-search-cloud composer",
        "test:unit": "wp-env run tests-cli --env-cwd=wp-content/plugins/webhead-search-cloud ./vendor/bin/phpunit --configuration phpunit.xml.dist",
        "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/webhead-search-cloud ./vendor/bin/phpunit --configuration phpunit-integration.xml.dist",
        "test:php": "npm run test:unit && npm run test:integration",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "env:destroy": "wp-env destroy",
        "test:integration:multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/webhead-search-cloud ./vendor/bin/phpunit --configuration phpunit-integration-multisite.xml.dist"
    },
    "author": "Mir Mohammad Hosseini <mh@webhead.dev>",
    "license": "GPL-3.0-or-later",
    "private": true,
    "dependencies": {
        "@wordpress/api-fetch": "^7.56.0",
        "@wordpress/base-styles": "^13.2.0",
        "@wordpress/block-editor": "~18.0.0",
        "@wordpress/blocks": "~16.1.0",
        "@wordpress/components": "^41.0.0",
        "@wordpress/dataviews": "~19.1.0",
        "@wordpress/date": "^5.56.0",
        "@wordpress/dom-ready": "^4.56.0",
        "@wordpress/element": "^8.8.0",
        "@wordpress/i18n": "^6.29.0",
        "@wordpress/icons": "~17.0.0",
        "@wordpress/theme": "~2.2.0",
        "@wordpress/ui": "~0.23.0",
        "@wordpress/url": "^4.56.0",
        "motion": "^14.0.0",
        "react-content-loader": "^7.1.2",
        "react-toastify": "^11.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@playwright/test": "^1.63.0",
        "@wordpress/babel-preset-default": "^8.36.0",
        "@wordpress/env": "^11.16.0",
        "@wordpress/eslint-plugin": "^25.6.0",
        "@wordpress/jest-preset-default": "^14.2.0",
        "@wordpress/scripts": "^36.0.0",
        "babel-jest": "^30.5.0",
        "babel-loader": "^10.1.1",
        "babel-plugin-prismjs": "^2.1.0",
        "eslint": "^10.6.0",
        "jest": "^30.5.0",
        "jest-environment-jsdom": "^30.5.0",
        "webpack": "^5.111.1",
        "webpack-remove-empty-scripts": "^1.1.1"
    },
    "overrides": {
        "js-yaml@5": "^5.4.1",
        "katex": "^0.18.2",
        "lighthouse": "^13.5.0",
        "markdownlint-cli": "^0.49.1",
        "postcss-selector-parser@6": "^7.1.6",
        "qs": "^6.16.0",
        "serialize-javascript": "^7.1.2",
        "smol-toml": "^1.9.0",
        "uuid": "^14.0.2"
    },
    "engines": {
        "node": ">=22.22.2",
        "npm": ">=10.2.3"
    }
}
