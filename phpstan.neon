parameters:
    level: max
    paths:
        - .
    excludePaths:
        - ./includes/Dependencies/*
        - ./includes/classes/*
        - ./languages/*
        - ./node_modules/*
        - ./phpcs-sniffs/*
        - ./public/*
        - ./src/*
        - ./tests/*
        - ./vendor/*
    fileExtensions:
        - php
    ignoreErrors:
        - identifier: constant.notFound
    dynamicConstantNames:
        - WEBHEADSEARCHCLOUDE_PLATFORM