#: src/admin/settings/components/tabs/SearchConfigTab.js:720
#, js-format
msgid "The search configuration could not be saved: %s"
msgstr "Die Sucheinstellungen konnten nicht gespeichert werden: %s"

#: src/admin/settings/components/tabs/SearchConfigTab.js:731
msgid "The popular searches and the category filter could not be saved."
msgstr "Die beliebten Suchanfragen und der Kategoriefilter konnten nicht gespeichert werden."

#: src/admin/settings/components/tabs/SearchConfigTab.js:738
msgid "Search configuration saved."
msgstr "Sucheinstellungen gespeichert."

#: src/admin/settings/components/tabs/SearchConfigTab.js:747
