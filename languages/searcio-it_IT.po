#. translators: %s: one or more quoted field names, e.g. "category".
#: src/admin/settings/components/tabs/SearchConfigTab.js:77
#, js-format
msgid "No document on this site has a %s field, so its facet will always be empty. Choose a field from the list, or start indexing it in the Indexing tab."
msgid_plural "No document on this site has the fields %s, so their facets will always be empty. Choose fields from the list, or start indexing them in the Indexing tab."
msgstr[0] "Nessun documento di questo sito ha un campo %s, quindi la sua faccetta sarà sempre vuota. Scegli un campo dall'elenco, oppure inizia a indicizzarlo nella scheda Indicizzazione."
msgstr[1] "Nessun documento di questo sito ha i campi %s, quindi le loro faccette saranno sempre vuote. Scegli dei campi dall'elenco, oppure inizia a indicizzarli nella scheda Indicizzazione."

#. translators: %s: one or more quoted field names, e.g. "category".
#: src/admin/settings/components/tabs/SearchConfigTab.js:88
#, js-format
msgid "No document on this site has a %s field, so it will never add a suggestion. Choose a field from the list, or start indexing it in the Indexing tab."
msgid_plural "No document on this site has the fields %s, so they will never add a suggestion. Choose fields from the list, or start indexing them in the Indexing tab."
msgstr[0] "Nessun documento di questo sito ha un campo %s, quindi non aggiungerà mai un suggerimento. Scegli un campo dall'elenco, oppure inizia a indicizzarlo nella scheda Indicizzazione."
msgstr[1] "Nessun documento di questo sito ha i campi %s, quindi non aggiungeranno mai un suggerimento. Scegli dei campi dall'elenco, oppure inizia a indicizzarli nella scheda Indicizzazione."

