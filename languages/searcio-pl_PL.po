#: src/admin/settings/components/tabs/SearchConfigTab.js:905
msgid "One comma-separated group of interchangeable words per line, e.g. \"sneaker, trainer\"."
msgstr "Jedna rozdzielona przecinkami grupa wymiennych słów w wierszu, np. \"sneakersy, trampki\"."

