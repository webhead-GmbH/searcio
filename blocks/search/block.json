{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "webhead-search-cloud/search",
	"version": "1.0.3",
	"title": "Search Cloud",
	"category": "widgets",
	"icon": "search",
	"description": "A full-screen search box or icon powered by webhead Search Cloud.",
	"textdomain": "webhead-search-cloud",
	"editorScript": "file:../../public/bundle.search-block-editor.js",
	"render": "file:./render.php",
	"attributes": {
		"instanceId": { "type": "string", "default": "" },
		"mode": { "type": "string", "default": "icon" },
		"scopeType": { "type": "string", "default": "" },
		"cardSource": { "type": "string", "default": "plugin" },
		"highlightsSource": { "type": "string", "default": "newest" },
		"placeholder": { "type": "string", "default": "" },
		"enableVoice": { "type": "boolean", "default": false },
		"searchTrigger": { "type": "string", "default": "submit" },
		"showCount": { "type": "boolean", "default": true },
		"animation": { "type": "string", "default": "fade" },
		"animationDuration": { "type": "number", "default": null },
		"carouselGap": { "type": "number", "default": null },
		"popularGap": { "type": "number", "default": null },

		"triggerIconColor": { "type": "string", "default": "" },
		"triggerIconColorHover": { "type": "string", "default": "" },
		"triggerBg": { "type": "string", "default": "" },
		"triggerBgHover": { "type": "string", "default": "" },
		"triggerRadius": { "type": "number", "default": null },
		"triggerIconSize": { "type": "number", "default": null },
		"triggerBtnSize": { "type": "number", "default": null },

		"bgColor": { "type": "string", "default": "" },
		"textColor": { "type": "string", "default": "" },
		"accentColor": { "type": "string", "default": "" },
		"radiusPanel": { "type": "number", "default": null },
		"modalPadding": { "type": "number", "default": null },
		"modalGap": { "type": "number", "default": null },

		"inputBgColor": { "type": "string", "default": "" },
		"inputTextColor": { "type": "string", "default": "" },
		"inputIconColor": { "type": "string", "default": "" },
		"inputPlaceholderColor": { "type": "string", "default": "" },
		"inputBorderColor": { "type": "string", "default": "" },
		"inputBorderFocusColor": { "type": "string", "default": "" },
		"inputRadius": { "type": "number", "default": null },

		"btnBg": { "type": "string", "default": "" },
		"btnBgHover": { "type": "string", "default": "" },
		"btnText": { "type": "string", "default": "" },
		"btnTextHover": { "type": "string", "default": "" },
		"btnRadius": { "type": "number", "default": null },

		"iconColor": { "type": "string", "default": "" },
		"iconColorHover": { "type": "string", "default": "" },
		"iconBgHover": { "type": "string", "default": "" },
		"voiceColor": { "type": "string", "default": "" },
		"voiceColorHover": { "type": "string", "default": "" },
		"voiceBg": { "type": "string", "default": "" },
		"voiceBgHover": { "type": "string", "default": "" },
		"closeColor": { "type": "string", "default": "" },
		"closeColorHover": { "type": "string", "default": "" },
		"closeBg": { "type": "string", "default": "" },
		"closeBgHover": { "type": "string", "default": "" },
		"clearBtnColor": { "type": "string", "default": "" },
		"clearBtnColorHover": { "type": "string", "default": "" },
		"clearBtnBg": { "type": "string", "default": "" },
		"clearBtnBgHover": { "type": "string", "default": "" },

		"panelBg": { "type": "string", "default": "" },
		"panelBorder": { "type": "string", "default": "" },
		"panelRadius": { "type": "number", "default": null },
		"suggestionText": { "type": "string", "default": "" },
		"suggestionTextHover": { "type": "string", "default": "" },
		"suggestionBgHover": { "type": "string", "default": "" },

		"titleColor": { "type": "string", "default": "" },
		"chipBg": { "type": "string", "default": "" },
		"chipText": { "type": "string", "default": "" },
		"chipBorder": { "type": "string", "default": "" },
		"chipBgHover": { "type": "string", "default": "" },
		"chipTextHover": { "type": "string", "default": "" },
		"chipBorderHover": { "type": "string", "default": "" },
		"chipRadius": { "type": "number", "default": null },
		"clearText": { "type": "string", "default": "" },
		"clearTextHover": { "type": "string", "default": "" },
		"clearBgHover": { "type": "string", "default": "" },
		"clearTextActive": { "type": "string", "default": "" },
		"popularText": { "type": "string", "default": "" },
		"popularTextHover": { "type": "string", "default": "" },
		"popularBgHover": { "type": "string", "default": "" },
		"popularRadius": { "type": "number", "default": null },

		"facetBg": { "type": "string", "default": "" },
		"facetText": { "type": "string", "default": "" },
		"facetBgHover": { "type": "string", "default": "" },
		"facetTextHover": { "type": "string", "default": "" },
		"facetBgActive": { "type": "string", "default": "" },
		"facetTextActive": { "type": "string", "default": "" },
		"facetCount": { "type": "string", "default": "" },
		"facetRadius": { "type": "number", "default": null },
		"facetsMaxHeight": { "type": "number", "default": null },

		"tabText": { "type": "string", "default": "" },
		"tabTextActive": { "type": "string", "default": "" },
		"tabIndicator": { "type": "string", "default": "" },
		"tabBorder": { "type": "string", "default": "" },

		"assistantAccent": { "type": "string", "default": "" },
		"assistantText": { "type": "string", "default": "" },
		"assistantUserBg": { "type": "string", "default": "" },
		"assistantUserText": { "type": "string", "default": "" },
		"assistantRowBg": { "type": "string", "default": "" },

		"cardBg": { "type": "string", "default": "" },
		"cardBorder": { "type": "string", "default": "" },
		"cardBorderHover": { "type": "string", "default": "" },
		"cardRadius": { "type": "number", "default": null },
		"cardPadding": { "type": "number", "default": null },
		"cardTitle": { "type": "string", "default": "" },
		"priceColor": { "type": "string", "default": "" },

		"arrowColor": { "type": "string", "default": "" },
		"arrowBg": { "type": "string", "default": "" },
		"dotColor": { "type": "string", "default": "" },
		"dotColorActive": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"align": false
	}
}
